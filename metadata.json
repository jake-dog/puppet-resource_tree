      "operatingsystemrelease": [ "8", "9" ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [ "8", "9" ]
    }
  ],
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">=8.2.0 <10.0.0" }
  ],
  "requirements": [
    { "name": "puppet", "version_requirement": ">=6.0.0 <9.0.0" }
  ]
