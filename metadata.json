{
  "name": "jake-resource_tree",
  "version": "2.0.0",
  "author": "jake",
  "license": "Apache-2.0",
  "summary": "Create Puppet resources dynamically in Hiera",
  "source": "https://github.com/jake-dog/puppet-resource_tree",
  "project_page": "https://github.com/jake-dog/puppet-resource_tree",
  "issues_url": "https://github.com/jake-dog/puppet-resource_tree/issues",
  "tags": [],
  "operatingsystem_support": [
    {
      "operatingsystem":"RedHat",
      "operatingsystemrelease":[ "6", "7", "8", "9" ]
    },
    {
